{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "types",
    "rootDir": "core",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "webworker"],
    "skipLibCheck": true,
    "noCheck": true
  },
  "include": ["core/**/*.js"],
  "exclude": ["core/**/*.test.js", "core/**/*.spec.js"]
}
